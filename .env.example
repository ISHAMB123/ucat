# Copy this file to .env and fill in your Supabase project values.
# Both are safe to expose in the browser bundle: the anon/publishable key
# is protected by Row Level Security, not secrecy. Find them in your
# Supabase dashboard under Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe Payment Link (e.g. https://buy.stripe.com/xxxxx). Empty = checkout off.
VITE_STRIPE_LINK=
